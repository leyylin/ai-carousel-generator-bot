# ============================================================
#  AI Carousel Generator Bot — configuration template
#  Copy this file to `.env` and fill in your own values:
#      cp .env.example .env
#  Never commit the real .env file.
# ============================================================

# ------------------------------------------------------------
# 1. Telegram bot (required)
# ------------------------------------------------------------
# Get a token from @BotFather: https://t.me/BotFather
BOT_TOKEN=
LOG_LEVEL=INFO

# ------------------------------------------------------------
# 2. Provider modes
# ------------------------------------------------------------
# AI_MODE    — text/script generation: "free" (open endpoint) or "paid" (OpenRouter)
# IMAGE_MODE — illustration generation:
#              "free"   → Pollinations FLUX (no key, rate-limited)
#              "local"  → Pollinations FLUX with a strict 1 image / 45 s limiter
#              "hf"     → Hugging Face Serverless Inference (needs HF_API_KEY)
#              "paid"   → Fal.ai (stub, not implemented yet)
AI_MODE=free
IMAGE_MODE=free

# ------------------------------------------------------------
# 3. Text LLM providers
# ------------------------------------------------------------
# Free OpenAI-compatible endpoint (no key needed, heavily rate-limited)
FREE_LLM_ENDPOINT=https://text.pollinations.ai/openai
FREE_LLM_MODEL=openai
FREE_LLM_API_KEY=

# Paid text LLM via OpenRouter (recommended for production)
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
# Used only as the HTTP-Referer / app-attribution header
OPENROUTER_SITE_URL=https://t.me/

# ------------------------------------------------------------
# 4. Image generation (Flux / Stable Diffusion)
# ------------------------------------------------------------
# Pollinations FLUX endpoint and prompt appendix
FREE_IMAGE_BASE_URL=https://image.pollinations.ai/prompt
FREE_IMAGE_MODEL=flux
# Canvas size of generated backgrounds (Instagram portrait 4:5)
IMAGE_WIDTH=1080
IMAGE_HEIGHT=1350
# Appended to every visual prompt. Tune it for your own visual style.
IMAGE_SUFFIX=, product photography, soft studio lighting, high resolution, editorial magazine style, 8k, no text, no watermark
IMAGE_CONCURRENCY=3
IMAGE_RETRIES=3
IMAGE_TIMEOUT=120

# Hugging Face Serverless Inference (IMAGE_MODE=hf)
# Token: https://huggingface.co/settings/tokens
# Text-to-image needs Inference Providers credits, otherwise HF returns HTTP 402.
HF_API_KEY=

# Paid image providers (optional stubs)
FAL_KEY=
REPLICATE_API_TOKEN=

# ------------------------------------------------------------
# 5. Generation limits
# ------------------------------------------------------------
LLM_TIMEOUT=90
LLM_RETRIES=2
# Number of slides per carousel (5–7)
SLIDES_COUNT=6

# ------------------------------------------------------------
# 6. Freemium limits and Telegram Stars subscription
# ------------------------------------------------------------
FREE_TRIAL_GENERATIONS=2
SUB_GENERATIONS_LIMIT=30
SUB_PRICE_STARS=250
SUB_DAYS=30

# ------------------------------------------------------------
# 7. Input validation limits
# ------------------------------------------------------------
MAX_TOPIC_LENGTH=300
MAX_FIELD_LENGTH=1200

# ------------------------------------------------------------
# 8. Storage and rendering
# ------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/carousel.db
# Where rendered PNG slides are written (git-ignored)
RENDER_OUTPUT_DIR=generated_carousel
RENDER_CONCURRENCY=1
# SEND_MEDIA_MODE: photo | document | both
SEND_MEDIA_MODE=photo

# ------------------------------------------------------------
# 9. Optional: standalone demo script (ai_carousel_ollama.py)
# ------------------------------------------------------------
# Free Unsplash developer key: https://unsplash.com/developers
# Without it the script falls back to a bundled curated photo pool.
UNSPLASH_ACCESS_KEY=
